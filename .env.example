# NVIDIA Nemotron Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional Local Server Port
PORT=3000
HOST=localhost


# Nemotron reasoning mode: "on" is smarter but ~3x slower per call
NEMOTRON_THINKING=off

# Shared team database on SpacetimeDB maincloud (leave unset to use the local one on 127.0.0.1:3108)
# SPACETIMEDB_URL=https://maincloud.spacetimedb.com
# SPACETIMEDB_DATABASE=fraudgraph-boblins
